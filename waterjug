from collections import deque

def water_jug():
    visited = set()
    q = deque([(0, 0)])

    while q:
        x, y = q.popleft()
        if (x, y) in visited:
            continue
        visited.add((x, y))

        print(x, y)

        if x == 2 or y == 2:
            print("Goal reached")
            return

        q.extend([
            (4, y), (x, 3), (0, y), (x, 0),
            (max(0, x-(3-y)), min(3, y+x)),
            (min(4, x+y), max(0, y-(4-x)))
        ])

water_jug()
